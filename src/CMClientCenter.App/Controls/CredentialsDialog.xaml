<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="CMClientCenter.App.Controls.CredentialsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Anmeldedaten"
    PrimaryButtonText="OK"
    CloseButtonText="Abbrechen"
    DefaultButton="Primary">

    <StackPanel Spacing="12" MinWidth="320">
        <TextBlock x:Name="HostInfo"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   FontSize="12"/>

        <StackPanel Spacing="4">
            <TextBlock Text="Benutzername" FontSize="12"/>
            <TextBox x:Name="UsernameBox"
                     PlaceholderText="DOMAIN\Benutzer oder Benutzer@domain.com"/>
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Text="Passwort" FontSize="12"/>
            <PasswordBox x:Name="PasswordBox"
                         PlaceholderText="Passwort eingeben"/>
        </StackPanel>

        <InfoBar IsOpen="True" IsClosable="False" Severity="Informational"
                 Message="Leer lassen für aktuellen Windows-Benutzer (Kerberos/NTLM)."/>
    </StackPanel>
</ContentDialog>
