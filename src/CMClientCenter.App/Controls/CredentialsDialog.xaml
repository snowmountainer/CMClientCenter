<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="CMClientCenter.App.Controls.CredentialsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Credentials"
    PrimaryButtonText="OK"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <StackPanel Spacing="12" MinWidth="320">
        <TextBlock x:Name="HostInfo"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   FontSize="12"/>

        <StackPanel Spacing="4">
            <TextBlock Text="Username" FontSize="12"/>
            <TextBox x:Name="UsernameBox"
                     PlaceholderText="DOMAIN\User or user@domain.com"/>
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Text="Password" FontSize="12"/>
            <PasswordBox x:Name="PasswordBox"
                         PlaceholderText="Enter password"/>
        </StackPanel>

        <InfoBar IsOpen="True" IsClosable="False" Severity="Informational"
                 Message="Leave empty to use the current Windows user (Kerberos/NTLM)."/>
    </StackPanel>
</ContentDialog>
