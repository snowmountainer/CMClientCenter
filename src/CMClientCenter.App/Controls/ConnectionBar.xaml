<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="CMClientCenter.App.Controls.ConnectionBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel>
        <Grid Padding="12,4" ColumnSpacing="8" Height="48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Ellipse Grid.Column="0" Width="10" Height="10"
                     x:Name="StatusDot" Fill="Gray" VerticalAlignment="Center"/>

            <TextBox Grid.Column="1" x:Name="HostBox"
                     PlaceholderText="Hostname oder IP-Adresse..."
                     Text="{x:Bind ViewModel.TargetHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     KeyDown="HostBox_KeyDown" VerticalAlignment="Center"/>

            <Button Grid.Column="2" Content="Verbinden"
                    Command="{x:Bind ViewModel.ConnectCommand}"
                    Style="{StaticResource AccentButtonStyle}"
                    VerticalAlignment="Center"/>

            <Button Grid.Column="3" x:Name="DisconnectButton"
                    Content="Trennen"
                    Command="{x:Bind ViewModel.DisconnectCommand}"
                    Visibility="Collapsed" VerticalAlignment="Center"/>

            <TextBlock Grid.Column="4" x:Name="StatusText"
                       Text="{x:Bind ViewModel.ConnectionStatus, Mode=OneWay}"
                       VerticalAlignment="Center" Margin="12,0,0,0"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

            <ProgressRing Grid.Column="5"
                          IsActive="{x:Bind ViewModel.IsConnecting, Mode=OneWay}"
                          Width="20" Height="20" Margin="8,0"/>
        </Grid>

        <!-- Fehleranzeige direkt unter der ConnectionBar -->
        <InfoBar x:Name="ErrorBar"
                 IsOpen="False"
                 Severity="Error"
                 IsClosable="True"
                 Margin="12,0,12,4"/>
    </StackPanel>
</UserControl>
