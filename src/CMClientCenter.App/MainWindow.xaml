<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="CMClientCenter.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CMClientCenter.App.Controls"
    Title="CM Client Center">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <controls:ConnectionBar Grid.Row="0" Margin="0,8,0,0"/>

        <NavigationView
            Grid.Row="1"
            x:Name="NavView"
            IsSettingsVisible="True"
            PaneDisplayMode="Left"
            OpenPaneLength="200"
            SelectionChanged="NavView_SelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem Content="Dashboard" Tag="Dashboard">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Home"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Agent Status" Tag="AgentStatus">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Flag"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Hardware" Tag="Hardware">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Switch"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Software" Tag="Software">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="AllApps"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Actions" Tag="Actions">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Play"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Software Center" Tag="SoftwareCenter">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Library"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Updates" Tag="Updates">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Sync"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                                <NavigationViewItem Content="Tools" Tag="Tools">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Setting"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Console" Tag="Console">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Admin"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Logs" Tag="Logs">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Document"/></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" Margin="12"/>
        </NavigationView>
    </Grid>
</Window>
