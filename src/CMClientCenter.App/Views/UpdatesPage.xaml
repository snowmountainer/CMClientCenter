<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CMClientCenter.App.Views.UpdatesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:CMClientCenter.Core.Models"
    xmlns:converters="using:CMClientCenter.App.Converters">

    <Page.Resources>
        <converters:StringNotEmptyToBoolConverter x:Key="StringNotEmptyToBoolConverter"/>

        <!-- Gemeinsames Item-Template fuer beide Tabs (All/Pending) — gleiche
             Daten, nur unterschiedlich gefiltert im Code-Behind. -->
        <DataTemplate x:Key="UpdateItemTemplate" x:DataType="models:CCMSoftwareUpdate">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               ToolTipService.ToolTip="{x:Bind Title}"/>
                    <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis">
                        <Run Text="KB"/><Run Text="{x:Bind Article}"/>
                    </TextBlock>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{x:Bind Status}"
                           VerticalAlignment="Center" FontSize="12"/>
                <Button Grid.Column="2" Content="Install" Tag="{x:Bind}"
                        VerticalAlignment="Center" Click="InstallUpdate_Click"
                        IsEnabled="{x:Bind InstallableUpdateId, Converter={StaticResource StringNotEmptyToBoolConverter}}"
                        ToolTipService.ToolTip="Not installable via this client yet — try Refresh, or wait for the next update scan cycle."/>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid RowSpacing="8" Padding="0,0,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Updates" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="Refresh" x:Name="RefreshButton" VerticalAlignment="Center"/>
        </Grid>

        <ProgressBar Grid.Row="1" x:Name="LoadingBar"
                     IsIndeterminate="True" Visibility="Collapsed"/>
        <InfoBar Grid.Row="1" x:Name="ResultBar" IsOpen="False" IsClosable="True"/>
        <InfoBar Grid.Row="2" x:Name="ErrorBar"
                 IsOpen="False" Severity="Error" IsClosable="True"/>

        <Pivot Grid.Row="3" x:Name="MainPivot">

            <!-- ───────────────────────── All Updates ───────────────────────── -->
            <PivotItem x:Name="AllUpdatesTab">
                <PivotItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="All Updates"/>
                        <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                                CornerRadius="10" Padding="8,1" VerticalAlignment="Center">
                            <TextBlock x:Name="AllCountText" Text="0"
                                       Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                </PivotItem.Header>

                <Grid RowSpacing="8" Padding="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBox Grid.Row="0"
                             x:Name="AllFilterBox"
                             PlaceholderText="Filter (title, article…)"
                             TextChanged="AllFilterBox_TextChanged"/>

                    <ListView Grid.Row="1" x:Name="AllList" SelectionMode="None"
                              ItemTemplate="{StaticResource UpdateItemTemplate}">
                        <ListView.Header>
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="0,0,0,1" Padding="12,8">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Title"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="Status"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </Grid>
                            </Border>
                        </ListView.Header>
                    </ListView>
                </Grid>
            </PivotItem>

            <!-- ───────────────────────── Pending Updates ───────────────────────── -->
            <PivotItem x:Name="PendingUpdatesTab">
                <PivotItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Pending Updates"/>
                        <Border Background="{ThemeResource SystemFillColorCautionBrush}"
                                CornerRadius="10" Padding="8,1" VerticalAlignment="Center">
                            <TextBlock x:Name="PendingCountText" Text="0"
                                       Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                </PivotItem.Header>

                <Grid RowSpacing="8" Padding="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBox Grid.Row="0"
                             x:Name="PendingFilterBox"
                             PlaceholderText="Filter (title, article…)"
                             TextChanged="PendingFilterBox_TextChanged"/>

                    <ListView Grid.Row="1" x:Name="PendingList" SelectionMode="None"
                              ItemTemplate="{StaticResource UpdateItemTemplate}">
                        <ListView.Header>
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="0,0,0,1" Padding="12,8">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Title"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="Status"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </Grid>
                            </Border>
                        </ListView.Header>
                    </ListView>
                </Grid>
            </PivotItem>

        </Pivot>
    </Grid>
</Page>
