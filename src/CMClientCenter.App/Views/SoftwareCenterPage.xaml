<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CMClientCenter.App.Views.SoftwareCenterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:CMClientCenter.Core.Models"
    xmlns:converters="using:CMClientCenter.App.Converters">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Page.Resources>

    <Grid RowSpacing="8" Padding="0,0,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Software Center" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="Refresh" x:Name="RefreshButton" VerticalAlignment="Center"/>
        </Grid>

        <ProgressBar Grid.Row="1" x:Name="LoadingBar"
                     IsIndeterminate="True" Visibility="Collapsed"/>
        <InfoBar Grid.Row="1" x:Name="ResultBar" IsOpen="False" IsClosable="True"/>
        <InfoBar Grid.Row="2" x:Name="ErrorBar"
                 IsOpen="False" Severity="Error" IsClosable="True"/>

        <Pivot Grid.Row="3" x:Name="MainPivot">

            <!-- ───────────────────────── Applications ───────────────────────── -->
            <PivotItem x:Name="ApplicationsTab">
                <PivotItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Applications"/>
                        <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                                CornerRadius="10" Padding="8,1" VerticalAlignment="Center">
                            <TextBlock x:Name="AppsCountText" Text="0"
                                       Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                </PivotItem.Header>

                <Grid RowSpacing="8" Padding="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBox Grid.Row="0"
                             x:Name="AppsFilterBox"
                             PlaceholderText="Filter (name, publisher, version…)"
                             TextChanged="AppsFilterBox_TextChanged"/>

                    <ListView Grid.Row="1" x:Name="AppsList" SelectionMode="None">

                        <ListView.Header>
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="0,0,0,1" Padding="12,8">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Name"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="Status"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </Grid>
                            </Border>
                        </ListView.Header>

                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="12,6"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:CCMApplication">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTipService.ToolTip="{x:Bind Name}"/>
                                        <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis">
                                            <Run Text="{x:Bind Publisher}"/><Run Text=" "/><Run Text="{x:Bind SoftwareVersion}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{x:Bind InstallState}"
                                               VerticalAlignment="Center" FontSize="12"/>
                                    <DropDownButton Grid.Column="2" Content="Action" VerticalAlignment="Center">
                                        <DropDownButton.Flyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="Install"   Tag="{x:Bind}" Click="AppAction_Click"/>
                                                <MenuFlyoutItem Text="Repair"    Tag="{x:Bind}" Click="AppAction_Click"/>
                                                <MenuFlyoutItem Text="Uninstall" Tag="{x:Bind}" Click="AppAction_Click"/>
                                            </MenuFlyout>
                                        </DropDownButton.Flyout>
                                    </DropDownButton>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>

            <!-- ───────────────────────── Operating Systems ───────────────────────── -->
            <PivotItem x:Name="OperatingSystemsTab">
                <PivotItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Operating Systems"/>
                        <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                                CornerRadius="10" Padding="8,1" VerticalAlignment="Center">
                            <TextBlock x:Name="TSCountText" Text="0"
                                       Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                </PivotItem.Header>

                <Grid RowSpacing="8" Padding="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBox Grid.Row="0"
                             x:Name="TSFilterBox"
                             PlaceholderText="Filter (name, publisher, version…)"
                             TextChanged="TSFilterBox_TextChanged"/>

                    <ListView Grid.Row="1" x:Name="TSList" SelectionMode="None">

                        <ListView.Header>
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="0,0,0,1" Padding="12,8">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Name"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="Last run"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </Grid>
                            </Border>
                        </ListView.Header>

                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="12,6"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:CCMTaskSequence">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTipService.ToolTip="{x:Bind Name}"/>
                                            <FontIcon Glyph="&#xE7BA;" FontSize="14"
                                                      Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                      Visibility="{x:Bind HighImpact, Converter={StaticResource BoolToVisibilityConverter}}"
                                                      ToolTipService.ToolTip="High impact — may reinstall the operating system"/>
                                        </StackPanel>
                                        <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis">
                                            <Run Text="{x:Bind Publisher}"/><Run Text=" "/><Run Text="{x:Bind Version}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{x:Bind LastRunStatus}"
                                               VerticalAlignment="Center" FontSize="12"/>
                                    <Button Grid.Column="2" Content="Run" Tag="{x:Bind}"
                                            VerticalAlignment="Center" Click="RunTaskSequence_Click"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>

        </Pivot>
    </Grid>
</Page>
