<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="CMClientCenter.App.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="16" MaxWidth="480" Margin="24">
        <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}"/>

        <StackPanel Spacing="4">
            <TextBlock Text="Theme" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <ComboBox x:Name="ThemeCombo" Width="240" HorizontalAlignment="Left"
                      SelectionChanged="ThemeCombo_SelectionChanged">
                <ComboBoxItem Content="System" Tag="System"/>
                <ComboBoxItem Content="Light"  Tag="Light"/>
                <ComboBoxItem Content="Dark"   Tag="Dark"/>
            </ComboBox>
        </StackPanel>

        <InfoBar x:Name="RestartBar" IsOpen="False" IsClosable="False" Severity="Informational"
                 Title="Restart required"
                 Message="Some elements (cards, backgrounds) only fully apply the new theme after restarting the app. The navigation pane updates immediately."/>
        <Button x:Name="RestartBarCloseButton" Content="Restart now" Click="RestartBar_Close_Click"
                HorizontalAlignment="Left" Visibility="Collapsed"/>

        <StackPanel Spacing="4">
            <TextBlock Text="Scripts folder (Console → Run PS)" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="ScriptsFolderBox" IsReadOnly="True"/>
                <Button Grid.Column="1" x:Name="BrowseScriptsFolderButton" Content="Browse..."/>
            </Grid>
            <TextBlock Text="Custom .ps1 files placed here appear on the Console page under &quot;Run PS&quot;."
                       FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
        </StackPanel>

        <TextBlock Text="TODO: WinRM timeout, credential storage" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

        <StackPanel Spacing="4">
            <TextBlock Text="About" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="12">
                <StackPanel Spacing="2">
                    <TextBlock x:Name="AboutAppNameText" FontWeight="SemiBold"/>
                    <TextBlock x:Name="AboutVersionText" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <HyperlinkButton x:Name="AboutRepoLink" Padding="0" Margin="0,4,0,0"
                                     Content="github.com/snowmountainer/CMClientCenter"
                                     NavigateUri="https://github.com/snowmountainer/CMClientCenter"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </StackPanel>
</Page>
