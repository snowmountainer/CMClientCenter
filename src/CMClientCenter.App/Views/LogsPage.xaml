<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CMClientCenter.App.Views.LogsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:CMClientCenter.Core.Models">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Linke Spalte: Log-Datei-Liste -->
        <Grid Grid.Column="0" RowSpacing="8" Margin="0,0,8,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Log-Dateien"
                       Style="{StaticResource SubtitleTextBlockStyle}"/>
            <Button Grid.Row="1" Content="Aktualisieren"
                    x:Name="RefreshFilesButton" HorizontalAlignment="Stretch"/>

            <ListView Grid.Row="2" x:Name="LogFileList"
                      SelectionMode="Single"
                      SelectionChanged="LogFileList_SelectionChanged">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:LogFileInfo">
                        <StackPanel>
                            <TextBlock Text="{x:Bind Name}"
                                       FontSize="12" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock FontSize="10"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                <Run Text="{x:Bind SizeKB}"/>
                                <Run Text=" KB  •  "/>
                                <Run Text="{x:Bind Modified}"/>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- Rechte Spalte: Log-Einträge -->
        <Grid Grid.Column="1" RowSpacing="8" Padding="8,0,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="LogTitle" Text="Logs"
                           Style="{StaticResource TitleTextBlockStyle}"
                           VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" x:Name="MaxLinesBox"
                          SelectedIndex="1" Margin="8,0"
                          SelectionChanged="MaxLinesBox_SelectionChanged">
                    <ComboBoxItem Content="100 Zeilen"/>
                    <ComboBoxItem Content="200 Zeilen"/>
                    <ComboBoxItem Content="500 Zeilen"/>
                    <ComboBoxItem Content="1000 Zeilen"/>
                </ComboBox>
                <Button Grid.Column="2" Content="Neu laden"
                        x:Name="RefreshLogButton"/>
            </Grid>

            <ProgressBar Grid.Row="1" x:Name="LoadingBar"
                         IsIndeterminate="True" Visibility="Collapsed"/>
            <InfoBar Grid.Row="2" x:Name="ErrorBar"
                     IsOpen="False" Severity="Error" IsClosable="True"/>
            <TextBox Grid.Row="3" x:Name="FilterBox"
                     PlaceholderText="Filter (Nachricht, Komponente…)"
                     TextChanged="FilterBox_TextChanged"/>

            <ListView Grid.Row="4" x:Name="EntriesList" SelectionMode="None">
                <ListView.Header>
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1" Padding="12,6">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="Zeit"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Grid.Column="2" Text="Komponente"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Grid.Column="3" Text="Nachricht"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Grid>
                    </Border>
                </ListView.Header>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="12,3"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:LogEntry">
                        <Grid ColumnSpacing="8" MinHeight="22">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Severity-Farbe als schmaler Streifen -->
                            <Border Grid.Column="0" x:Name="SeverityBar"
                                    CornerRadius="3" VerticalAlignment="Stretch"/>
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind Time}"
                                       FontSize="11" FontFamily="Consolas"
                                       VerticalAlignment="Top"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Grid.Column="2"
                                       Text="{x:Bind Component}"
                                       FontSize="11"
                                       VerticalAlignment="Top"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTipService.ToolTip="{x:Bind Component}"/>
                            <TextBlock Grid.Column="3"
                                       Text="{x:Bind Message}"
                                       FontSize="11" FontFamily="Consolas"
                                       TextWrapping="Wrap"
                                       ToolTipService.ToolTip="{x:Bind Message}"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
