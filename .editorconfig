# EditorConfig: https://editorconfig.org
# Codifies conventions already in use across this codebase (file-scoped
# namespaces, 4-space indent, C# 13 partial-property ViewModels — see
# CONTRIBUTING.md / CLAUDE.md) rather than introducing new ones.

root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.cs]
indent_size = 4

# File-scoped namespaces (namespace Foo.Bar; not namespace Foo.Bar { })
csharp_style_namespace_declarations = file_scoped:warning

# Nullable is enabled solution-wide; keep it that way in new code
dotnet_diagnostic.CS8600.severity = warning
dotnet_diagnostic.CS8602.severity = warning
dotnet_diagnostic.CS8603.severity = warning
dotnet_diagnostic.CS8625.severity = warning

# var: prefer explicit types except where the RHS makes the type obvious
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# Expression-bodied members: allowed for simple one-liners, not enforced
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = when_on_single_line:suggestion

# `this.` not needed — fields/properties are named distinctly enough
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion

# Braces: always, even for single-line if/for/while bodies
csharp_prefer_braces = true:suggestion

# using directives outside the namespace, System.* first
csharp_using_directive_placement = outside_namespace:suggestion
dotnet_sort_system_directives_first = true

[*.{xaml,axaml}]
indent_size = 4

[*.{json,props,targets,csproj,wixproj}]
indent_size = 2

[*.wxs]
indent_size = 2

[*.ps1]
indent_size = 4
# PSScripts target PS 5.1 (see CONTRIBUTING.md) — avoid formatting that
# implies PS7+-only syntax.

[*.md]
trim_trailing_whitespace = false
indent_size = 2

[*.{yml,yaml}]
indent_size = 2
