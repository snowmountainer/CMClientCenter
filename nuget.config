<?xml version="1.0" encoding="utf-8"?>
<!--
  Pins the package source explicitly instead of relying on whatever machine-
  or user-level NuGet.Config a contributor's environment happens to have.
  Without this, a misconfigured or compromised local package source could
  silently get picked up for restore — this makes nuget.org the only source
  for this repo regardless of what else is configured elsewhere.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>

  <!--
    Package source mapping: every package used in this solution (WiX SDK,
    CommunityToolkit.Mvvm, Microsoft.Extensions.*, Windows App SDK, test
    packages, ...) must resolve from nuget.org specifically, not just "some
    configured source". Prevents dependency confusion if another source is
    ever added to a contributor's machine-level config.
  -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
